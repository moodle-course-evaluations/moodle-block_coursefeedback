{{!
    @template block_coursefeedback/organization_default_surveypart_row

    A single row in the table of event types and their associated questionnaires for an organization.

    Example context (json):
    {
      "id": 1,
      "name": "Vorlesung",
      "surveypart_chooser_context": {
        "org_name": "Fakultät I",
        "has_global_surveyparts": true,
        "global_surveyparts": [
          {
            "id": 1,
            "name": "Survey #1"
          }
        ],
        "has_organization_surveyparts": true,
        "organization_surveyparts": [
          {
            "id": 2,
            "name": "Survey #2",
            "selected": true
          }
        ]
      }
    }
}}

<tr>
    <td>
        <input
                type="text"
                name="name-{{id}}"
                aria-label="{{#str}}eventtype, block_coursefeedback{{/str}}"
                value="{{name}}"
                class="form-control">
    </td>
    <td>
        <label class="sr-only" for="block_coursefeedback-surveypart-{{id}}-{{uniqid}}">
            {{#str}}questionnaire, block_coursefeedback{{/str}}
        </label>
        {{#surveypart_chooser_context}}
            {{< block_coursefeedback/surveypart_chooser }}
                {{$id}}block_coursefeedback-surveypart-{{id}}-{{uniqid}}{{/id}}
                {{$name}}surveypart-{{id}}{{/name}}
            {{/ block_coursefeedback/surveypart_chooser }}
        {{/surveypart_chooser_context}}
    </td>
    <td>
    </td>
</tr>
