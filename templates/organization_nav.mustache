{{!
    @template block_coursefeedback/organization_nav

    This template renders the organization overview page.

    Example context (json):
    {
      "organization_settings_url": {},
      "eventtypes_url": {},
      "courses_url": {},
      "evaluations_url": {},
      "questionnaires_url": {},
      "current_tab": "settings",
      "current_tab_is_settings": true
    }
}}

<div class="list-group">
    <a class="list-group-item list-group-item-action {{#current_tab_is_settings}}active{{/current_tab_is_settings}}"
       href="{{{organization_settings_url}}}">
        {{#str}}settings{{/str}}
    </a>
    {{#questionnaires_url}}
        <a class="list-group-item list-group-item-action {{#current_tab_is_questionnaires}}active{{/current_tab_is_questionnaires}}"
           href="{{{.}}}">
            {{#str}}questionnaires, block_coursefeedback, {{name}}{{/str}}
        </a>
    {{/questionnaires_url}}

    <div class="list-group-item">
        <label class="text-muted">Selected Semester</label>
        {{#semester_dropdown_context}}
            {{> block_coursefeedback/semester_dropdown }}
        {{/semester_dropdown_context}}
    </div>

    {{#semester_settings_url}}
        <a class="list-group-item list-group-item-action {{#current_tab_is_semester_settings}}active{{/current_tab_is_semester_settings}}"
           href="{{{semester_settings_url}}}">
            {{#str}}semester_settings, block_coursefeedback{{/str}}
        </a>
    {{/semester_settings_url}}
    {{#setup_new_semester_url}}
        <a class="list-group-item list-group-item-action {{#current_tab_is_semester_settings}}active{{/current_tab_is_semester_settings}}"
           href="{{{setup_new_semester_url}}}">
            {{#str}}setup_new_semester, block_coursefeedback{{/str}}
        </a>
    {{/setup_new_semester_url}}
    {{#eventtypes_url}}
        <a class="list-group-item list-group-item-action {{#current_tab_is_eventtypes}}active{{/current_tab_is_eventtypes}}"
           href="{{{eventtypes_url}}}">
            {{#str}}event_types, block_coursefeedback{{/str}}
        </a>
    {{/eventtypes_url}}
    {{#rub_eventtype_mapping_url}}
        <a class="list-group-item list-group-item-action"
           href="{{{rub_eventtype_mapping_url}}}">
            {{#str}}define_rub_eventtype_mapping, block_coursefeedback{{/str}}
        </a>
    {{/rub_eventtype_mapping_url}}
    {{#courses_url}}
        <a class="list-group-item list-group-item-action {{#current_tab_is_courses}}active{{/current_tab_is_courses}}"
           href="{{{courses_url}}}">
            {{#str}}list_of_courses_without_evaluation, block_coursefeedback{{/str}}
        </a>
    {{/courses_url}}
    {{#evaluations_url}}
        <a class="list-group-item list-group-item-action {{#current_tab_is_evaluations}}active{{/current_tab_is_evaluations}}"
           href="{{{evaluations_url}}}">
            {{#str}}list_of_evaluations, block_coursefeedback{{/str}}
        </a>
    {{/evaluations_url}}
</div>
