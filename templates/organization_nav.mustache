{{!
    @template block_coursefeedback/organization_nav

    This template renders the organization navigation buttons / sidebar.

    Example context (json):
    {
      "semester_dropdown_context": {
        "button_text": null,
        "semesters": [
          {
            "name": "SoSe 2025",
            "is_current": false,
            "is_selected": true,
            "is_initialized": true,
            "url": "http:\/\/localhost:8000\/blocks\/coursefeedback\/semester_settings.php?organizationid=1&amp;semesterid=74"
          },
          {
            "name": "WiSe 2025\/26",
            "is_current": false,
            "is_selected": false,
            "is_initialized": true,
            "url": "http:\/\/localhost:8000\/blocks\/coursefeedback\/semester_settings.php?organizationid=1&amp;semesterid=75"
          },
          {
            "name": "SoSe 2026",
            "is_current": false,
            "is_selected": false,
            "is_initialized": true,
            "url": "http:\/\/localhost:8000\/blocks\/coursefeedback\/semester_settings.php?organizationid=1&amp;semesterid=76"
          },
          {
            "name": "WiSe 2026\/27",
            "is_current": true,
            "is_selected": false,
            "is_initialized": true,
            "url": "http:\/\/localhost:8000\/blocks\/coursefeedback\/semester_settings.php?organizationid=1&amp;semesterid=77"
          }
        ],
        "selected_semester": {
          "name": "SoSe 2025",
          "is_current": false,
          "is_selected": true,
          "is_initialized": true,
          "url": "http:\/\/localhost:8000\/blocks\/coursefeedback\/semester_settings.php?organizationid=1&amp;semesterid=74"
        }
      },
      "organization_settings_url": "http:\/\/localhost:8000\/blocks\/coursefeedback\/organization_settings.php?id=1",
      "semester_settings_url": "http:\/\/localhost:8000\/blocks\/coursefeedback\/semester_settings.php?organizationid=1&amp;semesterid=74",
      "eventtypes_url": "http:\/\/localhost:8000\/blocks\/coursefeedback\/organization_default_surveypart.php?id=1&amp;orgsemid=4",
      "courses_url": "http:\/\/localhost:8000\/blocks\/coursefeedback\/organization_courses_without_evaluation.php?id=1&amp;orgsemid=4",
      "evaluations_url": "http:\/\/localhost:8000\/blocks\/coursefeedback\/organization_evaluations.php?id=1&amp;orgsemid=4",
      "questionnaires_url": "http:\/\/localhost:8000\/blocks\/coursefeedback\/surveyparts.php?organizationid=1",
      "current_tab": "semester_settings",
      "current_tab_is_semester_settings": true
    }
}}

<div class="block_coursefeedback-organization-nav">
    <nav class="list-group mb-3">
        <div class="list-group-item">
            <h6 class="mb-0">{{#str}}semester_independent_settings, block_coursefeedback{{/str}}</h6>
        </div>

        <a class="list-group-item list-group-item-action {{#current_tab_is_settings}}active{{/current_tab_is_settings}}"
           href="{{{organization_settings_url}}}">
            {{#str}}settings{{/str}}
        </a>
        {{#questionnaires_url}}
            <a class="list-group-item list-group-item-action {{#current_tab_is_questionnaires}}active{{/current_tab_is_questionnaires}}"
               href="{{{.}}}">
                {{#str}}questionnaires, block_coursefeedback, {{name}}{{/str}}
            </a>
        {{/questionnaires_url}}
    </nav>

    <nav class="list-group">
        <header class="list-group-item">
            <h6>{{#str}}semester_settings, block_coursefeedback{{/str}}</h6>
            <label class="text-muted">{{#str}}selected_semester, block_coursefeedback{{/str}}</label>
            {{#semester_dropdown_context}}
                {{> block_coursefeedback/semester_dropdown }}
            {{/semester_dropdown_context}}
        </header>

        {{#semester_settings_url}}
            <a class="list-group-item list-group-item-action {{#current_tab_is_semester_settings}}active{{/current_tab_is_semester_settings}}"
               href="{{{semester_settings_url}}}">
                {{#str}}semester_settings, block_coursefeedback{{/str}}
            </a>
        {{/semester_settings_url}}
        {{#setup_new_semester_url}}
            <a class="list-group-item list-group-item-action {{#current_tab_is_semester_settings}}active{{/current_tab_is_semester_settings}}"
               href="{{{setup_new_semester_url}}}">
                {{#str}}setup_new_semester, block_coursefeedback{{/str}}
            </a>
        {{/setup_new_semester_url}}
        {{#eventtypes_url}}
            <a class="list-group-item list-group-item-action {{#current_tab_is_eventtypes}}active{{/current_tab_is_eventtypes}}"
               href="{{{eventtypes_url}}}">
                {{#str}}event_types, block_coursefeedback{{/str}}
            </a>
        {{/eventtypes_url}}
        {{#rub_eventtype_mapping_url}}
            <a class="list-group-item list-group-item-action"
               href="{{{rub_eventtype_mapping_url}}}">
                {{#str}}define_rub_eventtype_mapping, block_coursefeedback{{/str}}
            </a>
        {{/rub_eventtype_mapping_url}}
        {{#courses_url}}
            <a class="list-group-item list-group-item-action {{#current_tab_is_courses}}active{{/current_tab_is_courses}}"
               href="{{{courses_url}}}">
                {{#str}}list_of_courses_without_evaluation, block_coursefeedback{{/str}}
            </a>
        {{/courses_url}}
        {{#evaluations_url}}
            <a class="list-group-item list-group-item-action {{#current_tab_is_evaluations}}active{{/current_tab_is_evaluations}}"
               href="{{{evaluations_url}}}">
                {{#str}}list_of_evaluations, block_coursefeedback{{/str}}
            </a>
        {{/evaluations_url}}
    </nav>
</div>