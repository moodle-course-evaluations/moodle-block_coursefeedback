{{!
    @template block_coursefeedback/surveypart_chooser

    A select input to choose between available global and organization-level survey parts.

    Example context (json):
    {
      "name": "surveypart-1",
      "id": "block_coursefeedback-surveypart-1-abcdefg",
      "org_name": "Fakultät I",
      "has_global_surveyparts": true,
      "global_surveyparts": [
        {
          "id": 1,
          "name": "Survey #1"
        }
      ],
      "has_organization_surveyparts": true,
      "organization_surveyparts": [
        {
          "id": 2,
          "name": "Survey #2",
          "selected": true
        }
      ]
    }
}}

<select class="form-control form-select w-100" name="{{$name}}{{name}}{{/name}}" id="{{$id}}{{id}}{{/id}}">
    <option value="">-</option>
    {{#has_global_surveyparts}}
        <optgroup label="Globale Fragebögen">
            {{#global_surveyparts}}
                <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
            {{/global_surveyparts}}
        </optgroup>
    {{/has_global_surveyparts}}
    {{#has_organization_surveyparts}}
        <optgroup label="Fragebögen in {{org_name}}">
            {{#organization_surveyparts}}
                <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
            {{/organization_surveyparts}}
        </optgroup>
    {{/has_organization_surveyparts}}
</select>